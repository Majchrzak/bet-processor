# PostgreSQL / TimescaleDB
POSTGRES_DB=bet_processor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=development-db-password
POSTGRES_PORT=5432

# API networking
API_PORT=3000
BET_PROCESSOR_HOST=0.0.0.0
BET_PROCESSOR_PORT=3000

# API database connection
BET_PROCESSOR_DATABASE_URL=postgresql://postgres:development-db-password@database:5432/bet_processor
BET_PROCESSOR_DB_POOL_SIZE=10
BET_PROCESSOR_DB_STATEMENT_TIMEOUT_MS=30000

# Authentication
BET_PROCESSOR_HMAC_SECRET=development-hmac-secret

# Runtime limits and logging
BET_PROCESSOR_LOG_LEVEL=info
BET_PROCESSOR_MAX_ACTIONS_PER_REQUEST=1000
BET_PROCESSOR_REQUEST_BODY_LIMIT_BYTES=1048576
BET_PROCESSOR_RTP_MAX_RANGE_DAYS=3660
