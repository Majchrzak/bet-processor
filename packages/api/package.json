{
  "name": "@bet-processor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "typeorm": "^0.3.27",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "migration:revert": "typeorm migration:revert -d dist/typeorm.config.js",
    "migration:run": "typeorm migration:run -d dist/typeorm.config.js",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
