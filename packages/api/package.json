{
  "name": "@bet-processor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
